{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "hol-guard-before-tool",
            "type": "command",
            "command": "node ${extensionPath}${/}hooks${/}hol-guard-before-tool.mjs",
            "timeout": 12000,
            "description": "Evaluate every Gemini CLI tool call with local HOL Guard before execution."
          }
        ]
      }
    ]
  }
}
